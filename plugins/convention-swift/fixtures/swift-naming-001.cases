#> case good: protocol named for its role
#> path: Sources/App/Data/UserStore.swift
import Foundation

protocol UserStore: Sendable {
    func user(id: User.ID) async throws -> User
}

final class RemoteUserStore: UserStore {
    func user(id: User.ID) async throws -> User { try await client.fetch(id) }
}
