#> case good: logging through the wrapper
#> path: Sources/App/Features/Notes/NotesStore.swift
@Observable
final class NotesStore {
    private let log = Log(category: "notes")

    func save(_ note: Note) async {
        log.info("Saved note", sensitive: note.title)
        // print("saved")
        let plan = blueprint(for: note)
    }
}
#> case good: the wrapper itself uses OSLog
#> path: Core/Logging/Log.swift
import OSLog

struct Log {
    private let logger: Logger
    init(category: String) {
        logger = Logger(subsystem: "app", category: category)
    }
}
