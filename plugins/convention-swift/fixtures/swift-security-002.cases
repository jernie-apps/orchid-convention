#> case good: stable id, redacted email, boolean flag, inside the logging wrapper
#> path: Sources/App/Core/Logging/SessionLogger.swift
import OSLog

struct SessionLogger {
    let logger = Logger(subsystem: "app", category: "auth")

    func signedIn(_ user: User) {
        logger.info("Signed in user \(user.id)")
        logger.info("Signed in \(user.email, privacy: .private)")
        print("Verified: \(user.isEmailVerified)")
    }
}
