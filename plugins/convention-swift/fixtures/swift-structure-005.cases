#> case good: fields, validation and an input value
#> path: Sources/App/Features/Notes/NoteForm/NoteDraft.swift
struct NoteDraft {
    var title = ""
    var body = ""

    init(note: Note? = nil) {
        title = note?.title ?? ""
        body = note?.body ?? ""
    }

    var input: NoteInput { NoteInput(title: title, body: body) }

    func validate() throws(NoteValidationError) { try NotePolicy.validate(title: title) }
}
