#> case good: view delegates loading to its store
#> path: Sources/App/Features/Orders/OrderListView.swift
import SwiftUI

struct OrderListView: View {
    @Environment(OrdersStore.self) private var store

    var body: some View {
        List(store.orders) { OrderRow(order: $0) }
            .task { await store.load() }
    }
}
#> case good: a repository implementation may use an injected URLSession
#> path: Packages/Data/Sources/Data/Orders/RemoteOrderRepository.swift
struct RemoteOrderRepository {
    let session: URLSession

    func fetch() async throws -> [Order] {
        let (data, _) = try await session.data(from: endpoint)
        return try JSONDecoder().decode([Order].self, from: data)
    }
}
#> case bad: view builds a request and fetches through the shared session
#> path: Sources/App/Features/Orders/OrderListView.swift
