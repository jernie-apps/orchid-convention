#> case good: key read from configuration and Keychain
#> path: Sources/App/Config/APIConfig.swift
import Foundation

struct APIConfig {
    let apiKey = Bundle.main.object(forInfoDictionaryKey: "API_KEY") as? String
    let token = try? Keychain.read(.authToken)

    func isMissing() -> Bool { token == "" }
}
