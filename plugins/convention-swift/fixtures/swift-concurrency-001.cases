#> case good: lifetime-bound .task, a button-action Task and a stored Task
#> path: Sources/App/Features/Feed/FeedView.swift
import SwiftUI

struct FeedView: View {
    @Environment(FeedStore.self) private var store
    @State private var refreshTask: Task<Void, Never>?

    var body: some View {
        List(store.items) { FeedRow(item: $0) }
            .task { await store.load() }
            .toolbar {
                Button(.feedReload) {
                    Task { await store.reload() }
                }
            }
            .refreshable { refreshTask = Task { await store.refresh() } }
            .onAppear { refreshTask = Task { await store.refresh() } }
            .onDisappear { refreshTask?.cancel() }
    }
}
#> case good: Task outside a view file is not this rule's concern
#> path: Sources/App/Services/SyncService.swift
func scheduleSync() {
    Task.detached { await sync() }
}
