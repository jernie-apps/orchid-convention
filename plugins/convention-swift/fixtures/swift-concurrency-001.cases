#> case good: lifetime-bound .task and a stored, cancelled Task
#> path: Sources/App/Features/Feed/FeedView.swift
import SwiftUI

struct FeedView: View {
    @State private var viewModel = FeedViewModel()
    @State private var refreshTask: Task<Void, Never>?

    var body: some View {
        List(viewModel.items) { FeedRow(item: $0) }
            .task { await viewModel.load() }
            .refreshable { refreshTask = Task { await viewModel.refresh() } }
            .onDisappear { refreshTask?.cancel() }
    }
}
#> case good: Task outside a view file is not this rule's concern
#> path: Sources/App/Services/SyncService.swift
func scheduleSync() {
    Task { await sync() }
}
