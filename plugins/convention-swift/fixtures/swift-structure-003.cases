public enum NoteRepositoryError: Error, Hashable {
    case notFound
}

public enum NoteChange: Hashable, Sendable {
    case saved(NoteID)
}

public protocol NoteRepository: Sendable {
    func note(id: NoteID) async throws(NoteRepositoryError) -> Note
}
