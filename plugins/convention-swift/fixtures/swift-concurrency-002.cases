import Foundation

final class ImageCache: @unchecked Sendable { // SAFETY: every access goes through lock
    private let lock = NSLock()
    private var storage: [URL: Data] = [:]
}

actor ThumbnailCache {
    private var storage: [URL: Data] = [:]
}
