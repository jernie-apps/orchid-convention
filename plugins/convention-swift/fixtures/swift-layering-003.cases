#> case good: view reads its store
#> path: Sources/App/Features/Notes/NoteList/NoteListView.swift
import SwiftUI

struct NoteListView: View {
    @Environment(NotesStore.self) private var store

    var body: some View {
        List(store.notes) { NoteRow(note: $0) }
            .task { await store.load() }
    }
}
#> case good: a store may hold a repository
#> path: Sources/App/Features/Notes/NotesStore.swift
@Observable
final class NotesStore {
    private let repository: any NoteRepository
    init(repository: any NoteRepository) { self.repository = repository }
}
